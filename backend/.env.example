DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_assistant
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
AI_PROVIDER=auto
AI_PROVIDER_ORDER=zhipu,openai,anthropic
AI_ENABLE_LOCAL_FALLBACK=true
AGENT_TEAM_AUTO_RUN_ENABLED=true
AI_RESUME_PARSER_ENABLED=true
AI_RESUME_PARSER_PROVIDER=auto
AI_RESUME_PARSER_PROVIDER_ORDER=zhipu,openai,anthropic
ANTHROPIC_RESUME_PARSER_MODEL=claude-opus-4-7
OPENAI_RESUME_PARSER_MODEL=gpt-4o
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email delivery
# Local development can keep console. Use smtp to send real interview emails.
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HR Talent
SMTP_USE_TLS=true
SMTP_USE_SSL=false
